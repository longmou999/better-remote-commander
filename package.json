{
  "name": "brc",
  "private": true,
  "version": "2.0.2",
  "description": "Better Remote Commander (BRC) - self-hosted remote desktop agent + MCP relay for Claude and ChatGPT",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "clean": "pnpm -r --filter \"./packages/*\" exec rimraf dist",
    "typecheck": "pnpm -r --filter \"./packages/*\" exec tsc --noEmit",
    "agent": "pnpm --filter brc-agent start",
    "relay": "pnpm --filter brc-relay start",
    "dev:relay": "pnpm --filter brc-relay build && node packages/relay/dist/cli.js",
    "dev:agent": "pnpm --filter brc-agent build && node packages/agent/dist/cli.js",
    "extract-tools": "node scripts/extract-tools.mjs",
    "pack:all": "node -e \"const fs=require('fs');fs.mkdirSync('dist-pack',{recursive:true});fs.copyFileSync('transfer/final_v3.pdf','dist-pack/final_v3.pdf.tgz')\"",
    "publish:all": "pnpm -r --filter \"./packages/*\" publish --access public",
    "test:unit": "node --test packages/relay/test/unit.test.mjs packages/agent/test/tool-metadata.test.mjs",
    "test:e2e": "node scripts/e2e-all.mjs",
    "test": "pnpm test:unit && pnpm test:e2e"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.0"
  }
}
