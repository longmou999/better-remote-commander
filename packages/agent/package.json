{
  "name": "brc-agent",
  "version": "2.0.2",
  "description": "Better Remote Commander (BRC) device agent - runs on the machine to be controlled, connects outbound to an BRC relay",
  "license": "MIT",
  "type": "module",
  "bin": {
    "brc-agent": "dist/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@wonderwhy-er/desktop-commander": "0.3.1",
    "brc-shared": "workspace:*",
    "open": "^10.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/ws": "^8.5.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shahidx0x/better-remote-commander.git",
    "directory": "packages/agent"
  },
  "engines": {
    "node": ">=22.13"
  },
  "homepage": "https://github.com/shahidx0x/better-remote-commander#readme",
  "keywords": [
    "mcp",
    "claude",
    "chatgpt",
    "remote-desktop",
    "remote-control",
    "terminal",
    "agent",
    "self-hosted",
    "desktop-commander"
  ]
}
